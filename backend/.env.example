# CitiLink Environment Configuration

# Application
PROJECT_NAME="CitiLink Transit & Ticketing Platform"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Database (PostgreSQL + PostGIS)
# Default format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="citilink"
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/citilink"

# Security / JWT
SECRET_KEY="citilink_super_secret_jwt_key_change_in_production_nashik_transit"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days

# Razorpay Integration (Simulation / Live)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
